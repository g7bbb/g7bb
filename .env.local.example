# 이 파일을 복사해서 .env.local 이라는 이름으로 저장하고, 실제 값으로 채워주세요.
# .env.local 파일은 절대 깃허브에 올리지 마세요 (.gitignore에 이미 등록되어 있습니다).

# Google AI Studio (https://aistudio.google.com) 에서 발급받은 API 키
GEMINI_API_KEY=

# 이미지 생성이 가능한 Gemini 모델 이름. Google이 종종 모델명을 바꾸므로,
# 문제가 생기면 https://ai.google.dev 최신 문서에서 이미지 생성 지원 모델명을 확인 후 이 값만 바꿔주세요.
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# 종이 마킹을 "읽는" 모델. 위 이미지 생성 모델과 **다른 모델**입니다.
# 여기에 이미지 생성 모델을 넣으면 종이를 읽는 대신 그림을 그려버립니다.
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Supabase 프로젝트 설정 > API 메뉴에서 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 카카오톡 채널 링크 (예: https://pf.kakao.com/_xxxxxx)
NEXT_PUBLIC_KAKAO_CHANNEL_URL=

# 구글 시트 기록용 (google-apps-script/sheet-logger.gs 설치 후 얻는 값)
# 이 두 값은 NEXT_PUBLIC_ 이 없어서 서버에서만 읽힙니다. 브라우저에 노출되지 않습니다.
# 비워두면 시트 기록만 건너뛰고 앱은 정상 동작합니다.
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_TOKEN=

# 예쁜 곤충 심사 화면(/admin/judge) 접속 암호. 운영자만 아는 값으로 정하세요.
# NEXT_PUBLIC_ 이 없어서 서버에서만 읽힙니다.
ADMIN_CODE=
